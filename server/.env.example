# ==============================================================
# Zenugo AI — Environment Variables Example
# ==============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file with real credentials.
# ==============================================================

# MongoDB (existing production database)
MONGODB_URI=mongodb+srv://your-connection-string
JWT_SECRET=your-jwt-secret

# OpenRouter API (existing AI integration)
OPENROUTER_API_KEY=your-openrouter-api-key

# PostgreSQL (concept demonstration only — NOT required for production)
# These are only used by server/postgres/postgresClient.js
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=zenugo_concepts
PG_USER=postgres
PG_PASSWORD=your-pg-password
